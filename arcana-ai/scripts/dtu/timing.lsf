#!/bin/bash
# timing.lsf — A2.0: what one game costs on the capsule, one deck per task.
#
#   cd ~/arcana-runs && bsub < ~/Repos/arcana/arcana-ai/scripts/dtu/timing.lsf
#
# Runs benchmark::tests::capsule_timing from the binary build.lsf left in
# ~/arcana-runs/<commit>/, where <commit> is the checkout's HEAD (the commit
# setup.sh and build.lsf used), with CAP_DECK = the task index − 1, and writes
# its rows to <tag>-deck<k>-from<first>.csv there. DTU's LSF does not forward
# the submitting shell's environment, so a variable reaches the job only
# through bsub -env, as in -env "all, ARCANA_COMMIT=<commit>, CAP_TIMING_GAMES=8".
#
# Shards: with A2_SHARDS=k each deck's games split into k consecutive ranges
# of CAP_TIMING_GAMES, and the array runs 5k tasks, task i taking deck
# (i-1)/k and the range starting at A2_FIRST_BASE + ((i-1) mod k) *
# CAP_TIMING_GAMES (A2_FIRST_BASE defaults to 0). A2_TAG names the files
# (default "timing"). A2.1's head-to-head at 12/120, games 1000 to 1215,
# three shards of 72 a deck, with -J overriding the five-task default:
#   bsub -J "arcana-h2h12[1-15]%24" -env "all, A2_TAG=h2h-12-120, A2_SHARDS=3,
#     A2_FIRST_BASE=1000, CAP_TIMING_BUDGETS=12/120, CAP_TIMING_GAMES=72,
#     CAP_TIMING_MIRROR=0" < timing.lsf
#
# A2.2's arm I, true-state against sampled-state vmc-material, games 2000 to
# 2215, A2_SHARDS shards a deck as its sizing step sets (four of 54 here):
#   bsub -J "arcana-info[1-20]%24" -env "all, A2_TAG=info, A2_SHARDS=4,
#     A2_FIRST_BASE=2000, CAP_TIMING_BUDGETS=none, CAP_TIMING_MIRROR=0,
#     CAP_TIMING_SAMPLED=1, CAP_TIMING_GAMES=54" < timing.lsf
#
# A retry names its range outright: with A2_DECK and A2_FIRST both set, the
# task plays CAP_TIMING_GAMES games of that deck from that game, whatever its
# index, so one failed shard is rerun as two jobs of half its games. A single
# game that exceeds its limit reruns alone with -W 4:00 on the command line.
# A game process peaked at 111 MB on the laptop, and deck 0's games cost 31 to
# 33 s at PIMC 12/120 and 6 to 9 s in the vmc mirror there, so a task of the
# default four games per pairing should take about 20 minutes. DTU refuses -M
# more than 5% above the rusage request.
#BSUB -q hpc
#BSUB -J arcana-timing[1-5]%5
#BSUB -n 1
#BSUB -R "rusage[mem=1GB]"
#BSUB -M 1GB
#BSUB -W 1:00
#BSUB -o timing_%J_%I.out
#BSUB -e timing_%J_%I.err
set -euo pipefail
repo="${ARCANA_REPO:-$HOME/Repos/arcana}"
commit="${ARCANA_COMMIT:-$(git -C "$repo" rev-parse HEAD)}"
out="$HOME/arcana-runs/$commit"
shards="${A2_SHARDS:-1}"
games="${CAP_TIMING_GAMES:-4}"
if [ -n "${A2_DECK:-}" ] || [ -n "${A2_FIRST:-}" ]; then
  deck="${A2_DECK:?a retry sets A2_DECK and A2_FIRST together}"
  first="${A2_FIRST:?a retry sets A2_DECK and A2_FIRST together}"
else
  deck=$(( (LSB_JOBINDEX - 1) / shards ))
  first=$(( ${A2_FIRST_BASE:-0} + (LSB_JOBINDEX - 1) % shards * games ))
fi
file="$out/${A2_TAG:-timing}-deck$deck-from$first.csv"
CAPSULE_DIR="$repo/docs/capsule-pioneer/seeds" CAP_DECK="$deck" CAP_TIMING_FIRST="$first" \
  "$out/arcana_ai_tests" --ignored --exact benchmark::tests::capsule_timing --nocapture \
  | grep '^timing,' > "$file"
echo "deck $deck games from $first on $(hostname): $(($(wc -l < "$file") - 1)) rows"
